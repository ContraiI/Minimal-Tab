{
  "manifest_version": 3,
  "name": "ZE 新标签页",
  "version": "0.8.5",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "替换 Edge 默认新标签页",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "https://suggestion.baidu.com/*",
    "https://suggestqueries.google.com/*",
    "https://api.bing.com/*",
    "https://www.baidu.com/*"
  ]
}